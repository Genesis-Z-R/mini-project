{
  "name": "estudy-backend",
  "version": "1.0.0",
  "description": "Node.js Express + Prisma + MySQL Backend for Estudy Student Workspace",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
